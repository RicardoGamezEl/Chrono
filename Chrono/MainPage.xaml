<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chrono.MainPage"
             Title="Chrono"
             >

    <VerticalStackLayout>
        <Label 
            x:Name="StatusLabel"
            Text="Organiza tus proyectos" 
            FontSize="12" 
            Padding="0,5"/>
        
        <Label 
            Text="Registra tu tiempo" 
            FontSize="12" 
            Padding="0,5"/>
        
        <Label 
            Text="Mejora tu productividad" 
            FontSize="12" 
            Padding="0,5"/>

        <Button Text="Mis proyectos" Clicked="OnProjectsClicked"/>
    </VerticalStackLayout>
</ContentPage>
