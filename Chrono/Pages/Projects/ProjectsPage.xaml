<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chrono.ProjectsPage"
             Title="Proyectos">
    <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding Projects}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Button
                        Text="{Binding Name}"
                        FontSize="18"
                        Margin="5"
                        Padding="10"
                        CommandParameter= "{Binding .}"
                        Clicked="OnProjectClicked"
                    />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label
            Text="Total de proyectos: 0"
            FontSize="16"
            Padding="0,10"
        />
        <Button
           Text="+ Nuevo proyecto"
           Clicked="OnNewProjectClicked"
        />

    </VerticalStackLayout>
</ContentPage>