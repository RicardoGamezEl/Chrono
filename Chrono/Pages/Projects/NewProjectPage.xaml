<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chrono.NewProjectPage"
             Title="Nuevo Proyecto">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label 
                x:Name="PageHeaderLabel"
                Text="Nuevo Proyecto"
                FontSize="24"
                FontAttributes="Bold" />

            <Label 
                Text="Nombre *"
                FontSize="15"
                FontAttributes="Bold"/>
            <Entry 
                x:Name="NameEntry"
                Placeholder="Ej. Mi Proyecto Increíble"/>

            <Label 
                Text="Descripción"
                FontSize="15"
                FontAttributes="Bold"/>
            <Editor 
                x:Name="DescriptionEditor"
                Placeholder="Descripción o notas del proyecto"
                HeightRequest="120"/>

            <Button 
                x:Name="SaveButton"
                Text="Guardar"
                Clicked="OnSaveClicked"
                Margin="0,10,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>