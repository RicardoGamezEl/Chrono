<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chrono.Pages.Tasks.SessionHistoryPage"
             Title="Historial de Sesiones">
    <Grid RowDefinitions="Auto,*" Padding="15" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label
                x:Name="TaskTitleLabel"
                Text="Historial de Tarea"
                FontSize="22"
                FontAttributes="Bold" />

            <Label
                x:Name="TotalTimeLabel"
                Text="Tiempo total acumulado: 00:00:00"
                FontSize="14"
                TextColor="#512BD4"
                FontAttributes="Bold" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Entries}">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="30" Spacing="10">
                    <Label
                        Text="No hay sesiones de tiempo registradas."
                        FontSize="16"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Inicia el temporizador para comenzar a registrar tu tiempo."
                        FontSize="13"
                        TextColor="Gray"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 8" Padding="12" Margin="0,4">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Label
                                        Text="{Binding FormattedDuration}"
                                        FontSize="18"
                                        FontAttributes="Bold" />
                                    <Label
                                        Text="● EN CURSO"
                                        FontSize="11"
                                        TextColor="#28A745"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding IsActive}" />
                                </HorizontalStackLayout>

                                <Label
                                    Text="{Binding FormattedPeriod}"
                                    FontSize="12"
                                    TextColor="Gray" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="Eliminar"
                                FontSize="12"
                                BackgroundColor="#D9534F"
                                TextColor="White"
                                Clicked="OnDeleteEntryClicked"
                                CommandParameter="{Binding .}"
                                VerticalOptions="Center"
                                Padding="10,6" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
