<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chrono.Pages.Tasks.TimerPage"
             Title="Temporizador">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <VerticalStackLayout Spacing="4">
                <Label
                    x:Name="TaskTitleLabel"
                    Text="Tarea"
                    FontSize="24"
                    FontAttributes="Bold" />

                <Label
                    x:Name="ProjectNameLabel"
                    Text="Proyecto"
                    FontSize="14"
                    TextColor="Gray" />

                <Label
                    x:Name="TaskStatusLabel"
                    Text="Estado: Sin Iniciar"
                    FontSize="13"
                    TextColor="#512BD4"
                    FontAttributes="Bold" />
            </VerticalStackLayout>

            <Border
                StrokeShape="RoundRectangle 16"
                Padding="24"
                BackgroundColor="{AppThemeBinding Light=#F7F7F9, Dark=#262626}">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Label
                        x:Name="StatusBadgeLabel"
                        Text="DETENIDO"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="Gray"
                        HorizontalOptions="Center" />

                    <Label
                        x:Name="TimerModeLabel"
                        Text="TIEMPO RESTANTE"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#512BD4"
                        CharacterSpacing="1"
                        HorizontalOptions="Center" />

                    <Label
                        x:Name="TimerDisplayLabel"
                        Text="00:00:00"
                        FontSize="56"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                    <Label
                        x:Name="SessionStartLabel"
                        Text="Sin sesión activa"
                        FontSize="13"
                        TextColor="Gray"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Métricas de Sesión y Presupuesto -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border
                    Grid.Column="0"
                    StrokeShape="RoundRectangle 10"
                    Padding="12"
                    BackgroundColor="{AppThemeBinding Light=#F4F4F6, Dark=#1F1F1F}">
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                        <Label Text="Presupuesto" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                        <Label
                            x:Name="PlannedBudgetLabel"
                            Text="00:00:00"
                            FontSize="15"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="12"
                    BackgroundColor="{AppThemeBinding Light=#F4F4F6, Dark=#1F1F1F}">
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                        <Label Text="Esta Sesión" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                        <Label
                            x:Name="CurrentSessionElapsedLabel"
                            Text="00:00:00"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#28A745"
                            HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="2"
                    StrokeShape="RoundRectangle 10"
                    Padding="12"
                    BackgroundColor="{AppThemeBinding Light=#F4F4F6, Dark=#1F1F1F}">
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                        <Label Text="Acumulado" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                        <Label
                            x:Name="TotalAccumulatedTimeLabel"
                            Text="00:00:00"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#512BD4"
                            HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <VerticalStackLayout Spacing="12">
                <Button
                    x:Name="StartButton"
                    Text="▶ Iniciar Sesión"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="#28A745"
                    TextColor="White"
                    Clicked="OnStartClicked"
                    HeightRequest="50" />

                <Button
                    x:Name="StopButton"
                    Text="⏹ Finalizar Sesión"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="#DC3545"
                    TextColor="White"
                    Clicked="OnStopClicked"
                    IsEnabled="False"
                    HeightRequest="50" />

                <Button
                    x:Name="HistoryButton"
                    Text="📜 Ver Historial de Sesiones"
                    FontSize="14"
                    Clicked="OnHistoryClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
