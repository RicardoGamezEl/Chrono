<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chrono.Pages.Tasks.TasksPage"
             Title="Tareas">
    <Grid RowDefinitions="Auto,*,Auto" Padding="15" RowSpacing="10">
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label
                x:Name="TitleProject"
                Text="Tareas del proyecto"
                FontSize="24"
                FontAttributes="Bold" />

            <Label
                x:Name="ProjectIdLabel"
                FontSize="14"
                TextColor="Gray" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Tasks}">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="30" Spacing="10">
                    <Label Text="No hay tareas en este proyecto."
                           FontSize="16"
                           HorizontalOptions="Center" />
                    <Label Text="Toca en '+ Nueva tarea' para crear la primera."
                           FontSize="13"
                           TextColor="Gray"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 8" Padding="12" Margin="0,5">
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="8">
                                <Label
                                    Text="{Binding Title}"
                                    FontSize="18"
                                    FontAttributes="Bold" />
                                <Label
                                    Text="● EN CURSO"
                                    FontSize="11"
                                    TextColor="#28A745"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HasActiveSession}" />
                            </HorizontalStackLayout>

                            <Label
                                Text="{Binding Description}"
                                FontSize="13"
                                TextColor="Gray" />

                            <Label
                                Text="{Binding FormattedTotalTime, StringFormat='⏱ Tiempo: {0}'}"
                                FontSize="12"
                                TextColor="#512BD4"
                                FontAttributes="Bold" />

                            <FlexLayout JustifyContent="SpaceBetween" AlignItems="Center" Wrap="Wrap">
                                <Button
                                    Text="{Binding StatusDisplay}"
                                    FontSize="12"
                                    Clicked="OnStatusClicked"
                                    CommandParameter="{Binding .}"
                                    Margin="0,4"/>

                                <HorizontalStackLayout Spacing="6" Margin="0,4">
                                    <Button
                                        Text="⏱ Cronómetro"
                                        FontSize="12"
                                        Clicked="OnTimerClicked"
                                        CommandParameter="{Binding .}"/>

                                    <Button
                                        Text="📜 Historial"
                                        FontSize="12"
                                        Clicked="OnHistoryClicked"
                                        CommandParameter="{Binding .}"/>

                                    <Button
                                        Text="Editar"
                                        FontSize="12"
                                        Clicked="OnEditTaskClicked"
                                        CommandParameter="{Binding .}"/>

                                    <Button
                                        Text="Eliminar"
                                        FontSize="12"
                                        BackgroundColor="#D9534F"
                                        Clicked="OnDeleteTaskClicked"
                                        CommandParameter="{Binding .}"/>
                                </HorizontalStackLayout>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="2"
            Text="+ Nueva tarea"
            Clicked="OnNewTaskClicked"
            Margin="0,5,0,0"/>
    </Grid>
</ContentPage>