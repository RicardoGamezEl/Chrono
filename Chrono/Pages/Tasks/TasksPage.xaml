<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chrono.Pages.Tasks.TasksPage"
             Title="TasksPage">
    <VerticalStackLayout Padding="20">

        <Label
        Text="Tareas del proyecto"
        x:Name="TitleProject"
        FontSize="30" />

        <Label
        x:Name="ProjectIdLabel"
        FontSize="16" />

        <Button
            Text="+ Nueva tarea"
            Clicked="OnNewTaskClicked"/>

        <CollectionView ItemsSource="{Binding Tasks}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label
                    Text="{Binding Title}"
                    FontSize="18"
                    Padding="10" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>