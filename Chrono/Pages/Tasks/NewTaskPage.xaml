<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chrono.Pages.Tasks.NewTaskPage"
             Title="NewTaskPage">
    <VerticalStackLayout Padding="20">

        <Label
            Text="Nueva tarea"
            FontSize="30" />
        <Label
            Text="Título"
            FontSize="16"/>
        <Entry
            x:Name="TitleEntry"
            Placeholder="Ej. Crear interfaz" />

        <Label
            Text="Descripción"
            FontSize="16" />
 
        <Editor
            x:Name="DescriptionEditor"
            Placeholder="Describe la tarea" />

        <Button
            Text="Guardar"
            Clicked="OnSaveClicked" />

    </VerticalStackLayout>
</ContentPage>