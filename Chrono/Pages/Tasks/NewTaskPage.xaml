<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chrono.Pages.Tasks.NewTaskPage"
             Title="Nueva Tarea">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label
                x:Name="PageHeaderLabel"
                Text="Nueva Tarea"
                FontSize="24"
                FontAttributes="Bold" />

            <Label
                Text="Título *"
                FontSize="15"
                FontAttributes="Bold"/>
            <Entry
                x:Name="TitleEntry"
                Placeholder="Ej. Crear interfaz de usuario" />

            <Label
                Text="Descripción"
                FontSize="15"
                FontAttributes="Bold" />

            <Editor
                x:Name="DescriptionEditor"
                Placeholder="Describe los detalles de la tarea"
                HeightRequest="120" />

            <Button
                x:Name="SaveButton"
                Text="Guardar"
                Clicked="OnSaveClicked"
                Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>