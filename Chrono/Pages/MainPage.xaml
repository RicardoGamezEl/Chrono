<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chrono.MainPage"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Encabezado y Acciones Rápidas -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                <VerticalStackLayout Grid.Column="0" Grid.Row="0">
                    <Label
                        Text="Dashboard"
                        FontSize="28"
                        FontAttributes="Bold" />
                    <Label
                        Text="Resumen de productividad y seguimiento de tiempo"
                        FontSize="13"
                        TextColor="Gray" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Grid.Row="0" Spacing="8" VerticalOptions="Center">
                    <Button
                        Text="📁 Proyectos"
                        FontSize="13"
                        Clicked="OnProjectsClicked"
                        HeightRequest="42" />
                    <Button
                        Text="+ Nuevo"
                        FontSize="13"
                        Clicked="OnNewProjectClicked"
                        HeightRequest="42" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Tarjeta Principal: Tiempo Total Trabajado -->
            <Border
                StrokeShape="RoundRectangle 16"
                BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#2B0B98}"
                Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="TIEMPO TOTAL REGISTRADO"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#E1E1E1"
                        CharacterSpacing="1" />

                    <Label
                        Text="{Binding FormattedTotalTime}"
                        FontSize="44"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <BoxView HeightRequest="1" Color="#80FFFFFF" Margin="0,4" />

                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label
                                Text="Hoy"
                                FontSize="12"
                                TextColor="#DFD8F7" />
                            <Label
                                Text="{Binding FormattedTodayTime}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="White" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label
                                Text="Esta Semana"
                                FontSize="12"
                                TextColor="#DFD8F7" />
                            <Label
                                Text="{Binding FormattedWeekTime}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Resumen de Métricas Clave (Tarjetas) -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border
                    Grid.Column="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="14"
                    BackgroundColor="{AppThemeBinding Light=#F4F4F6, Dark=#1F1F1F}">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Proyectos"
                            FontSize="12"
                            TextColor="Gray" />
                        <Label
                            Text="{Binding TotalProjects}"
                            FontSize="24"
                            FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="14"
                    BackgroundColor="{AppThemeBinding Light=#F4F4F6, Dark=#1F1F1F}">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Tareas"
                            FontSize="12"
                            TextColor="Gray" />
                        <Label
                            Text="{Binding TotalTasks}"
                            FontSize="24"
                            FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="2"
                    StrokeShape="RoundRectangle 12"
                    Padding="14"
                    BackgroundColor="{AppThemeBinding Light=#F4F4F6, Dark=#1F1F1F}">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Completadas"
                            FontSize="12"
                            TextColor="#28A745" />
                        <Label
                            Text="{Binding CompletedTasks}"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="#28A745" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Tarjeta de Progreso Global -->
            <Border
                StrokeShape="RoundRectangle 14"
                Padding="16"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#242424}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label
                                Text="Avance Global de Tareas"
                                FontSize="16"
                                FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                <Label
                                    Text="{Binding CompletedTasks, StringFormat='{0} completadas'}"
                                    FontSize="12"
                                    TextColor="#28A745" />
                                <Label Text="·" TextColor="Gray" FontSize="12"/>
                                <Label
                                    Text="{Binding InProgressTasks, StringFormat='{0} en progreso'}"
                                    FontSize="12"
                                    TextColor="#512BD4" />
                                <Label Text="·" TextColor="Gray" FontSize="12"/>
                                <Label
                                    Text="{Binding PendingTasks, StringFormat='{0} pendientes'}"
                                    FontSize="12"
                                    TextColor="Gray" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="{Binding FormattedGlobalProgress}"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#512BD4"
                            VerticalOptions="Center" />
                    </Grid>

                    <ProgressBar
                        Progress="{Binding GlobalProgressRatio}"
                        ProgressColor="#512BD4"
                        HeightRequest="8" />
                </VerticalStackLayout>
            </Border>

            <!-- Sección: Proyectos y Avance -->
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Grid.Column="0"
                        Text="Proyectos y Avance"
                        FontSize="20"
                        FontAttributes="Bold" />
                    <Button
                        Grid.Column="1"
                        Text="Ver todos"
                        FontSize="12"
                        Clicked="OnProjectsClicked"
                        Padding="10,0"
                        HeightRequest="32" />
                </Grid>

                <!-- Vista vacía si no hay proyectos -->
                <Border
                    StrokeShape="RoundRectangle 12"
                    Padding="20"
                    x:Name="EmptyProjectsView">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label
                            Text="Aún no tienes proyectos creados."
                            FontSize="15"
                            HorizontalOptions="Center" />
                        <Label
                            Text="Registra tu primer proyecto para medir tiempo y tareas."
                            FontSize="12"
                            TextColor="Gray"
                            HorizontalOptions="Center" />
                        <Button
                            Text="+ Crear Proyecto"
                            FontSize="13"
                            Clicked="OnNewProjectClicked"
                            Margin="0,6,0,0"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Lista de Proyectos -->
                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Projects}"
                    Spacing="10"
                    x:Name="ProjectsStack">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border
                                StrokeShape="RoundRectangle 12"
                                Padding="14"
                                BackgroundColor="{AppThemeBinding Light=#FAFAFC, Dark=#212121}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding ProjectName}"
                                            FontSize="17"
                                            FontAttributes="Bold" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding FormattedTotalTime, StringFormat='⏱ {0}'}"
                                            FontSize="14"
                                            TextColor="#512BD4"
                                            FontAttributes="Bold" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding TasksSummary}"
                                            FontSize="12"
                                            TextColor="Gray" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding FormattedProgress}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="#512BD4" />
                                    </Grid>

                                    <ProgressBar
                                        Progress="{Binding ProgressRatio}"
                                        ProgressColor="#512BD4"
                                        HeightRequest="6" />

                                    <Button
                                        Text="Ver Tareas"
                                        FontSize="12"
                                        Clicked="OnOpenProjectClicked"
                                        CommandParameter="{Binding .}"
                                        HorizontalOptions="End"
                                        HeightRequest="34"
                                        Padding="14,0"
                                        Margin="0,4,0,0" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Sección: Actividad Reciente -->
            <VerticalStackLayout Spacing="10" Margin="0,0,0,20">
                <Label
                    Text="Actividad Reciente"
                    FontSize="20"
                    FontAttributes="Bold" />

                <!-- Vista vacía si no hay actividad -->
                <Border
                    StrokeShape="RoundRectangle 12"
                    Padding="18"
                    x:Name="EmptyActivitiesView">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label
                            Text="Sin sesiones de tiempo recientes."
                            FontSize="14"
                            HorizontalOptions="Center" />
                        <Label
                            Text="Inicia el cronómetro en cualquiera de tus tareas para registrar actividad."
                            FontSize="12"
                            TextColor="Gray"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Lista de Actividades Recientes -->
                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding RecentActivities}"
                    Spacing="8"
                    x:Name="RecentActivitiesStack">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border
                                StrokeShape="RoundRectangle 10"
                                Padding="12"
                                BackgroundColor="{AppThemeBinding Light=#FAFAFC, Dark=#212121}">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label
                                                Text="{Binding TaskTitle}"
                                                FontSize="15"
                                                FontAttributes="Bold" />
                                            <Label
                                                Text="● EN CURSO"
                                                FontSize="10"
                                                TextColor="#28A745"
                                                FontAttributes="Bold"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding IsActive}" />
                                        </HorizontalStackLayout>
                                        <Label
                                            Text="{Binding ProjectName, StringFormat='Proyecto: {0}'}"
                                            FontSize="12"
                                            TextColor="Gray" />
                                        <Label
                                            Text="{Binding FormattedDate}"
                                            FontSize="11"
                                            TextColor="Gray" />
                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding FormattedDuration}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="#512BD4"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
